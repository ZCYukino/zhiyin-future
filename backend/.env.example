# ============================================================
#  环境配置模板（复制为 .env 使用）
#
#  本文件只放模型名 / 服务地址 / 管理员账号等非密钥配置。
#  API Key 不在这里配，登录后在网页端配：
#    · 普通用户：「API Key 管理」页配 DeepSeek Key
#    · 管理员  ：「数据管理」页配 DeepSeek Key 与阿里云百炼 Key
# ============================================================

# ① 大模型（对话/生成）：DeepSeek
#    申请：https://platform.deepseek.com
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash

# ② 向量模型（embedding）：阿里云百炼 DashScope
#    申请：https://bailian.console.aliyun.com
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3

# ============================================================
#  管理员账号（用户名在 .env 改，密码登录后在网页端改）
# ============================================================

# 管理员登录用户名（改完重启后端即生效）
ADMIN_USERNAME=ZCY

# 管理员初始密码：仅首次创建账号时使用；之后登录在「个人中心 → 修改密码」改，
# 服务重启不会重置密码
ADMIN_PASSWORD=123456

# ============================================================
#  以下一般无需修改
# ============================================================

# 用户数据库文件路径（SQLite）。留空即用默认 backend/data/users.db，
# 也可以整行删掉——空值按未设置处理（见 config._env）
# DB_PATH=

# JWT 鉴权密钥（生产环境请改为随机长字符串）
JWT_SECRET=zhiyin-future-jwt-secret-change-me
JWT_EXPIRE_HOURS=24
